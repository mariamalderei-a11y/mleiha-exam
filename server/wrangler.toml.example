name = "mirqat-exam-api"
main = "src/index.js"
compatibility_date = "2026-10-23"

[vars]
# Set this to the exact deployed static-site origins, comma-separated.
ALLOWED_ORIGINS = "https://REPLACE_WITH_GITHUB_PAGES_ORIGIN"

[[d1_databases]]
binding = "DB"
database_name = "mirqat-exam"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
